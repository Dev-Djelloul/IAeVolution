{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iaevolution",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "iaevolution.digitalblueskye.com",
      "custom_domain": true
    }
  ],
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
